# 统一 UTF-8 + LF 行尾，防止跨平台编码损坏（2026-08 乱码事故后新增）
* text=auto

# 源码与文本文件强制 UTF-8 + LF
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.mp3  binary
*.wav  binary
*.mp4  binary
*.db   binary
*.sqlite binary

# Pin .gitignore to LF in the working tree (CRLF working copy creates a catch-all ignore rule)
/.gitignore text eol=lf

# 治理文件自身固定 LF：防止 Windows checkout 转 CRLF 影响规则解析（2026-09-18）
/.gitattributes text eol=lf
/.mailmap text eol=lf

# 无扩展名构建/清单文件固定 LF
Dockerfile text eol=lf
Makefile text eol=lf

# Trellis 版本/身份标记文件无扩展名，session_context.py 按文本读取 `.version`，
# 必须锁 LF（否则 Windows 工作区会被转成 CRLF，strip() 虽然兼容，但内容哈希会漂）。
/.trellis/.version text eol=lf

# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union
